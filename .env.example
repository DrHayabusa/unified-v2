# Copy this file to .env for private server configuration.
# Do not commit .env. MVA does not accept AI keys or model URLs in the browser.

# PostgreSQL
MVA_POSTGRES_PASSWORD=mva_local_only
VITE_MVA_DATABASE_API_URL=http://127.0.0.1:8787

# Private LiteLLM proxy route used only by the Fastify API.
LITELLM_URL=http://127.0.0.1:4000
LITELLM_API_KEY=CHANGE_ME
LITELLM_MODEL=organization-model-alias
LITELLM_CONNECT_TIMEOUT_MS=10000
LITELLM_READ_TIMEOUT_MS=600000

# API security. Use true behind production HTTPS.
COOKIE_SECURE=false
TRUST_PROXY=false
CORS_ORIGINS=http://127.0.0.1:8820,http://localhost:8820
